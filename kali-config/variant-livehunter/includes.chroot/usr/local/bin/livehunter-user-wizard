#!/bin/bash
# LiveHunter — мастер создания пользователя при первом входе

MARKER="/etc/livehunter/first-run-done"
LOGFILE="/var/log/livehunter-wizard.log"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" | sudo tee -a "$LOGFILE" >/dev/null 2>&1 || \
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOGFILE" 2>/dev/null || true
}

# Если пользователь уже создан ранее — просто выйти
if [ -f "$MARKER" ]; then
    exit 0
fi

log "Wizard started"

# Список типичных слабых паролей — блокируем их явно
COMMON_PASSWORDS="password 12345678 qwerty123 letmein admin123 password123 kali1234 toor123 rootroot iloveyou 11111111 87654321"

zenity --info --title="Добро пожаловать в Kali LiveHunter" \
    --text="Сейчас нужно создать основного пользователя системы.\nНажмите OK, чтобы продолжить." \
    --width=400

while true; do
    USERNAME=$(zenity --entry --title="Kali LiveHunter — создание пользователя" \
        --text="Введите имя пользователя (латиницей, без пробелов):")

    if [ -z "$USERNAME" ]; then
        log "Wizard cancelled at username step"
        exit 1
    fi

    if ! [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
        zenity --error --text="Некорректное имя пользователя.\nИспользуйте латиницу в нижнем регистре, цифры, - и _."
        continue
    fi

    PASSWORD=$(zenity --password --title="Kali LiveHunter — пароль")
    if [ -z "$PASSWORD" ]; then
        log "Wizard cancelled at password step"
        exit 1
    fi

    PASSWORD_CONFIRM=$(zenity --password --title="Kali LiveHunter — подтверждение пароля")

    if [ "$PASSWORD" != "$PASSWORD_CONFIRM" ]; then
        zenity --error --text="Пароли не совпадают. Попробуйте ещё раз."
        continue
    fi

    if [ ${#PASSWORD} -lt 8 ]; then
        zenity --error --text="Пароль слишком короткий (минимум 8 символов)."
        continue
    fi

    # Пароль не должен совпадать с логином (в любом регистре)
    if [ "${PASSWORD,,}" == "${USERNAME,,}" ]; then
        zenity --error --text="Пароль не должен совпадать с именем пользователя."
        continue
    fi

    # Проверка на распространённые слабые пароли
    PASSWORD_LOWER="${PASSWORD,,}"
    IS_WEAK=0
    for weak in $COMMON_PASSWORDS; do
        if [ "$PASSWORD_LOWER" == "$weak" ]; then
            IS_WEAK=1
            break
        fi
    done

    if [ "$IS_WEAK" -eq 1 ]; then
        zenity --error --text="Этот пароль слишком распространён и небезопасен.\nВыберите другой пароль."
        continue
    fi

    # Проверка на разнообразие символов (минимум 2 из 4 категорий)
    CATS=0
    [[ "$PASSWORD" =~ [a-z] ]] && CATS=$((CATS+1))
    [[ "$PASSWORD" =~ [A-Z] ]] && CATS=$((CATS+1))
    [[ "$PASSWORD" =~ [0-9] ]] && CATS=$((CATS+1))
    [[ "$PASSWORD" =~ [^a-zA-Z0-9] ]] && CATS=$((CATS+1))

    if [ "$CATS" -lt 2 ]; then
        zenity --warning --text="Пароль слабоват (используйте буквы разного регистра, цифры или символы).\nВсё равно продолжаем, но рекомендуем усилить его позже командой passwd." \
            --width=400
    fi

    break
done

log "Attempting to create user: $USERNAME"

# Вызов root-хелпера через pkexec
if pkexec /usr/local/sbin/livehunter-create-user "$USERNAME" "$PASSWORD"; then
    log "User $USERNAME created successfully"
    zenity --info --title="Готово" \
        --text="Пользователь $USERNAME успешно создан.\nСписок установленных инструментов откроется сейчас."
    /usr/local/bin/livehunter-tools-gui
else
    EXIT_CODE=$?
    log "Failed to create user $USERNAME (exit code $EXIT_CODE)"
    zenity --error --text="Не удалось создать пользователя (код ошибки: $EXIT_CODE).\nПодробности в $LOGFILE.\nПопробуйте снова после перезагрузки."
fi
